{
  "manifest_version": 3,
  "name": "StreamRate",
  "version": "2.1.0",
  "description": "Automatically displays IMDb ratings on Prime Video and Netflix.",
   "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://www.omdbapi.com/*",
    "https://api.agregarr.org/*",
    "https://api.themoviedb.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.netflix.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}